# Prisma Postgres — required on Vercel (Project → Settings → Environment Variables)
# Local: run `npx prisma postgres link` or paste your Postgres connection string.
# No quotes around the value. Example shape:
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=

# Optional — future Clerk integration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# REQUIRED for password reset + Google sign-in — base URL used to build
# password-reset links and the Google OAuth redirect URI. There is no
# fallback to the incoming request's Host header (that would let a spoofed
# Host redirect these links to an attacker-controlled domain).
# In dev this is usually http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email delivery (password reset + manager invites) ---
# The app tries providers in this order: Gmail SMTP, then Resend, then it just
# logs the email to the server console (dev-friendly fallback).
#
# Option 1 — Gmail SMTP (no domain needed; sends from your Gmail to anyone).
# Requires 2-Step Verification on the Google account, then create an App
# Password at myaccount.google.com/apppasswords and paste the 16-char value.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option 2 — Resend (resend.com). RESEND_FROM_EMAIL must be on a domain you've
# verified at resend.com/domains, otherwise sends to arbitrary recipients fail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

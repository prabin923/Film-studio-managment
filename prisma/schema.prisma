generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id             String   @id
  studioName     String
  phone          String   @default("")
  location       String   @default("")
  tagline        String   @default("")
  ownerEmail     String
  logoData       String   @default("")
  brandColor     String   @default("#2563eb")
  brandTextColor String   @default("#ffffff")
  brandShape     String   @default("rounded")
  currency       String   @default("NPR")
  locale         String   @default("en-NP")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts  Account[]
  clients   Client[]
  expenses  Expense[]
  staff     StaffRecord[]
  inventory InventoryItem[]
  rentals   Rental[]
  bills     Bill[]
}

model Account {
  id           String   @id
  workspaceId  String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  role         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resetTokens PasswordResetToken[]

  @@index([workspaceId])
}

model PasswordResetToken {
  id        String    @id
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model RateLimitHit {
  id        String   @id
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Client {
  id             String   @id
  workspaceId    String
  name           String
  phone          String   @default("")
  projectType    String
  eventDate      String
  createdAt      String
  location       String   @default("")
  packageAmount  Int
  paidAmount     Int
  paymentStatus  String
  assignedStaff  String   @default("")
  status         String
  notes          String   @default("")
  createdBy      String   @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Expense {
  id          String @id
  workspaceId String
  date        String
  category    String
  vendor      String @default("")
  amount      Int
  notes       String @default("")
  createdBy   String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model StaffRecord {
  id            String @id
  workspaceId   String
  name          String
  role          String
  monthlySalary Int
  advance       Int
  deduction     Int
  status        String
  createdBy     String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("staff")
}

model InventoryItem {
  id          String @id
  workspaceId String
  name        String
  category    String
  serial      String @default("")
  condition   String @default("")
  dayRate     Int
  status      String
  createdBy   String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Rental {
  id              String @id
  workspaceId     String
  renter          String
  phone           String @default("")
  itemId          String
  startDate       String
  endDate         String
  deposit         Int
  amount          Int
  paidAmount      Int
  status          String
  returnCondition String @default("")
  createdBy       String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Bill {
  id              String @id
  workspaceId     String
  number          String
  sourceType      String @default("custom")
  sourceId        String @default("")
  customerName    String
  customerPhone   String @default("")
  customerAddress String @default("")
  issueDate       String
  dueDate         String
  status          String
  subtotal        Int
  discount        Int    @default(0)
  taxRate         Float  @default(0)
  taxAmount       Int    @default(0)
  total           Int
  paidAmount      Int    @default(0)
  notes           String @default("")
  terms           String @default("")
  createdBy       String @default("")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lineItems BillLine[]

  @@unique([workspaceId, number])
  @@index([workspaceId])
}

model BillLine {
  id          String @id
  billId      String
  description String
  quantity    Float
  unitPrice   Int
  position    Int

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

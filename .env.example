# Prisma Postgres — required on Vercel (Project → Settings → Environment Variables)
# Local: run `npx prisma postgres link` or paste your Postgres connection string.
# No quotes around the value. Example shape:
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=

# Optional — future Clerk integration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

{
  "name": "wedstudio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-styles": "cp app/globals.css public/globals.css",
    "dev": "rm -rf .next && npm run sync-styles && next dev",
    "dev:clean": "npm run dev",
    "build": "npm run sync-styles && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-prisma.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "animejs": "^4.4.1",
    "dotenv": "^16.5.0",
    "next": "^14.2.3",
    "pg": "^8.16.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pg": "^8.15.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "tsx": "^4.19.4"
  }
}
